{
  "version": 3,
  "permissions": [
    {
      "resource": "photos",
      "component": "photo-api",
      "description": "A user's uploaded photos",
      "actions": [
        { "handle": "read", "description": "The caller's own photos" },
        { "handle": "upload", "description": "Upload a new photo (request a presigned URL, then record it)" },
        { "handle": "edit", "description": "Edit a photo's title, description, or image" },
        { "handle": "delete", "description": "Delete a photo" }
      ]
    }
  ],
  "groups": [
    { "name": "Users", "description": "Everyone who signs in to the photo app" }
  ],
  "roles": [
    {
      "name": "User",
      "description": "Uploads, views, edits, and deletes their own photos.",
      "stories": [1, 2, 3, 4, 5, 6],
      "grants": ["photos:read", "photos:upload", "photos:edit", "photos:delete"],
      "assignTo": ["Users"]
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] },
    { "username": "test-user-2", "roles": ["User"] }
  ]
}
